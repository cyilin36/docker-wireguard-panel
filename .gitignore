.wgpanel/

# Scratch that must never be published: local overrides, backups, image dumps
compose.override.yaml
docker-compose.override.yml
*.bak
*.orig
*.tar
*.tar.gz
*.tgz
*.zip
scratch/
tmp/
*.tmp

# Local agent state for this working copy (skills, per-project agent config):
